<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Tugasku INFTIK ku</title>

  <style>
    * {
      box-sizing: border-box;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      margin: 0;
      min-height: 100vh;
      font-family: Arial, sans-serif;
      color: #222;
    }

    .halaman {
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 20px;
    }

    #halamanKode {
      background: linear-gradient(135deg, #32105f, #a044ff);
    }

    .kotak-kode {
      width: 100%;
      max-width: 420px;
      padding: 35px 25px;
      text-align: center;
      background: white;
      border-radius: 22px;
      box-shadow: 0 15px 40px rgba(0, 0, 0, 0.3);
    }

    .ikon {
      font-size: 52px;
      margin-bottom: 12px;
    }

    .keterangan {
      color: #666;
      line-height: 1.6;
    }

    input[type="password"] {
      width: 100%;
      margin-top: 10px;
      padding: 14px;
      border: 1px solid #ccc;
      border-radius: 10px;
      font-size: 16px;
    }

    button {
      width: 100%;
      margin-top: 16px;
      padding: 14px;
      border: none;
      border-radius: 10px;
      color: white;
      background: #7224c9;
      font-size: 16px;
      font-weight: bold;
      cursor: pointer;
    }

    button:hover {
      background: #521491;
    }

    #pesanSalah {
      min-height: 22px;
      margin-top: 14px;
      color: #d00000;
      font-weight: bold;
    }

    #halamanFoto {
      display: none;
      flex-direction: column;
      justify-content: flex-start;
      align-items: center;
      background: linear-gradient(135deg, #f5f0ff, #ffffff);
      text-align: center;
      padding-top: 25px;
      overflow-y: auto;
    }

    .isi-foto {
      width: 100%;
      max-width: 950px;
    }

    .judul-tugas {
      margin: 0 0 12px;
      padding: 20px 15px;
      color: white;
      background: linear-gradient(135deg, #32105f, #a044ff);
      border-radius: 16px;
      font-size: 32px;
    }

    .jam-wib {
      display: inline-block;
      margin-bottom: 20px;
      padding: 12px 22px;
      color: white;
      background: #222;
      border-radius: 30px;
      font-size: 20px;
      font-weight: bold;
    }

    .keterangan-halaman {
      color: #666;
      line-height: 1.6;
    }

    .daftar-gambar {
      display: flex;
      flex-direction: column;
      gap: 25px;
      width: 100%;
    }

    .kartu-gambar {
      width: 100%;
      padding: 14px;
      background: white;
      border: 1px solid #ddd;
      border-radius: 16px;
      box-shadow: 0 8px 25px rgba(0, 0, 0, 0.12);
    }

    .kartu-gambar h2 {
      margin: 5px 0 14px;
      color: #32105f;
      font-size: 24px;
    }

    .gambar-tugas {
      display: block;
      width: 100%;
      height: auto;
      max-height: 850px;
      object-fit: contain;
      border-radius: 10px;
    }

    .pesan-gambar {
      display: none;
      padding: 30px 10px;
      color: #777;
      line-height: 1.6;
    }

    .tombol-kunci {
      width: auto;
      min-width: 180px;
      margin: 25px auto 10px;
    }

    @media (max-width: 600px) {
      .halaman {
        padding: 15px;
      }

      .kotak-kode {
        padding: 28px 20px;
      }

      .judul-tugas {
        font-size: 25px;
      }

      .jam-wib {
        font-size: 17px;
      }

      .kartu-gambar {
        padding: 8px;
      }

      .kartu-gambar h2 {
        font-size: 20px;
      }
    }
  </style>
</head>
<body>

  <!-- HALAMAN 1 -->
  <section id="halamanKode" class="halaman">
    <div class="kotak-kode">
      <div class="ikon">🔐</div>

      <h1>Selamat Datang</h1>

      <p class="keterangan">
        Silakan masukkan password untuk membuka tugas.
      </p>

      <form id="formKode">
        <label for="kodeRahasia">Masukkan password</label>

        <input
          id="kodeRahasia"
          type="password"
          placeholder="Masukkan password"
          autocomplete="off"
          required
        >

        <button type="submit">🔓 Buka Tugas</button>

        <div id="pesanSalah"></div>
      </form>
    </div>
  </section>


  <!-- HALAMAN 2 -->
  <section id="halamanFoto" class="halaman">
    <div class="isi-foto">

      <h1 class="judul-tugas">Tugasku INFTIK ku</h1>

      <div class="jam-wib" id="jamWib">
        WIB: 00:00:00
      </div>

      <p class="keterangan-halaman">
        Selamat datang di halaman tugas dan profil saya.
      </p>

      <div class="daftar-gambar">

        <div class="kartu-gambar">
          <h2>Profil INFTIK</h2>
          <img class="gambar-tugas" src="gambar-inftik.jpg" alt="Profil INFTIK">
          <div class="pesan-gambar">Gambar Profil INFTIK tidak ditemukan.</div>
        </div>

        <div class="kartu-gambar">
          <h2>Data Profil Siswa</h2>
          <img class="gambar-tugas" src="data-profil.jpg" alt="Data Profil Siswa">
          <div class="pesan-gambar">Gambar Data Profil Siswa tidak ditemukan.</div>
        </div>

        <div class="kartu-gambar">
          <h2>Riwayat Pendidikan</h2>
          <img class="gambar-tugas" src="riwayat-pendidikan.jpg" alt="Riwayat Pendidikan">
          <div class="pesan-gambar">Gambar Riwayat Pendidikan tidak ditemukan.</div>
        </div>

        <div class="kartu-gambar">
          <h2>Riwayat Prestasi</h2>
          <img class="gambar-tugas" src="riwayat-prestasi.jpg" alt="Riwayat Prestasi">
          <div class="pesan-gambar">Gambar Riwayat Prestasi tidak ditemukan.</div>
        </div>

        <div class="kartu-gambar">
          <h2>Hobi dan Minat</h2>
          <img class="gambar-tugas" src="hobi-minat.jpg" alt="Hobi dan Minat">
          <div class="pesan-gambar">Gambar Hobi dan Minat tidak ditemukan.</div>
        </div>

      </div>

      <button id="tombolKunci" class="tombol-kunci" type="button">
        🔒 Kunci Lagi
      </button>

    </div>
  </section>


  <script>
    const halamanKode = document.getElementById("halamanKode");
    const halamanFoto = document.getElementById("halamanFoto");
    const formKode = document.getElementById("formKode");
    const kodeRahasia = document.getElementById("kodeRahasia");
    const pesanSalah = document.getElementById("pesanSalah");
    const tombolKunci = document.getElementById("tombolKunci");
    const jamWib = document.getElementById("jamWib");

    const kodeBenar = "SuaraKuTugas1";

    formKode.addEventListener("submit", function(event) {
      event.preventDefault();

      if (kodeRahasia.value === kodeBenar) {
        halamanKode.style.display = "none";
        halamanFoto.style.display = "flex";
        pesanSalah.textContent = "";
        perbaruiJamWIB();
      } else {
        pesanSalah.textContent = "Password salah. Silakan coba lagi.";
        kodeRahasia.select();
      }
    });

    function perbaruiJamWIB() {
      const waktuWIB = new Intl.DateTimeFormat("id-ID", {
        timeZone: "Asia/Jakarta",
        hour: "2-digit",
        minute: "2-digit",
        second: "2-digit",
        hour12: false
      }).format(new Date());

      jamWib.textContent = "WIB: " + waktuWIB;
    }

    setInterval(perbaruiJamWIB, 1000);

    document.querySelectorAll(".gambar-tugas").forEach(function(gambar) {
      gambar.addEventListener("error", function() {
        gambar.style.display = "none";
        gambar.nextElementSibling.style.display = "block";
      });
    });

    tombolKunci.addEventListener("click", function() {
      halamanFoto.style.display = "none";
      halamanKode.style.display = "flex";
      kodeRahasia.value = "";
      pesanSalah.textContent = "";
      kodeRahasia.focus();
      window.scrollTo(0, 0);
    });
  </script>

</body>
</html>
